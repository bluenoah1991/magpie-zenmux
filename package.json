{
  "name": "magpie-zenmux",
  "version": "0.2.1",
  "description": "ZenMux Builder Plan and Pay As You Go provider plugin for Magpie",
  "keywords": [
    "magpie",
    "opencode",
    "opencode-plugin",
    "zenmux",
    "provider"
  ],
  "homepage": "https://github.com/bluenoah1991/magpie-zenmux",
  "bugs": "https://github.com/bluenoah1991/magpie-zenmux/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluenoah1991/magpie-zenmux.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.mjs"
  },
  "main": "./index.mjs",
  "files": [
    "index.mjs",
    "src",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "npm run format:check && node scripts/check.mjs",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "prepack": "node scripts/sync-icon.mjs"
  },
  "devDependencies": {
    "@dprint/json": "0.25.2",
    "@dprint/markdown": "0.27.1",
    "@dprint/typescript": "0.96.1",
    "dprint": "0.64.1"
  },
  "engines": {
    "node": ">=22"
  },
  "magpie": {
    "icon": "data:image/svg+xml;base64,"
  }
}
